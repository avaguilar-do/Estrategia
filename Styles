/* =========================================================
Tablero de estrategia — estilos
Paleta corporativa: Azul Profundo, Azul Horizonte (dominante),
Naranja Legado (atención) y Rojo Cercanía (crítico).
Sin frameworks, sin dependencias externas.
========================================================= */

:root {
/* Paleta corporativa
Azul Profundo #1B355D · Pantone 534 C
Naranja Legado #E75301 · Pantone 166 C
Rojo Cercania #983920 · Pantone 174 C
Azul Horizonte #7DACE3 · Pantone 2142 C */

--ink: #0e1e37; /* Azul Profundo oscurecido: fondo */
--panel: #1b355d; /* Azul Profundo 100%: tarjetas */
--panel-2: #23456f;
--line: #2e5686;
--line-soft: #24446c;
--text: #eaf2fb;
--muted: #9fbede; /* Azul Horizonte 60%: texto de apoyo */

--azul: #7dace3; /* Azul Horizonte 100%: acento principal */
--azul-claro: #a9cbec; /* Azul Horizonte 80%: enlaces y datos */
--azul-tenue: #d1e3f6; /* Azul Horizonte 40% */
--naranja: #e75301; /* Naranja Legado: atención y foco activo */
--rojo: #e08f75; /* Rojo Cercanía aclarado: legible sobre azul profundo */

--radio: 14px;
--radio-s: 8px;
--ancho: 1140px;

--serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
--sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
--mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}

html[data-theme="light"] {
--ink: #eaf1f9; /* Azul Horizonte 20% */
--panel: #ffffff;
--panel-2: #dceaf7;
--line: #b4d1ea;
--line-soft: #dbe8f5;
--text: #14294a; /* Azul Profundo */
--muted: #4d6e97;

--azul: #2c6ca6;
--azul-claro: #1f5c94;
--azul-tenue: #7dace3;
--naranja: #c24500;
--rojo: #8a3320;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 88px; }

body {
margin: 0;
background: var(--ink);
color: var(--text);
font-family: var(--sans);
font-size: 16px;
line-height: 1.6;
-webkit-font-smoothing: antialiased;
}

h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.2; margin: 0; }
p { margin: 0; }
a { color: inherit; }

.visually-hidden {
position: absolute; width: 1px; height: 1px;
padding: 0; margin: -1px; overflow: hidden;
clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.skip {
position: absolute; left: -9999px; top: 0; z-index: 100;
background: var(--naranja); color: #0e1e37;
padding: 10px 16px; border-radius: 0 0 var(--radio-s) 0;
font-weight: 600; text-decoration: none;
}
.skip:focus { left: 0; }

:focus-visible {
outline: 2px solid var(--naranja);
outline-offset: 2px;
border-radius: 4px;
}

/* ---------------- Barra superior ---------------- */

.topbar {
position: sticky; top: 0; z-index: 30;
background: var(--ink);
background: color-mix(in srgb, var(--ink) 92%, transparent);
backdrop-filter: blur(10px);
border-bottom: 1px solid var(--line-soft);
}
.topbar__inner {
max-width: var(--ancho);
margin: 0 auto;
padding: 12px 20px;
display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
}

.brand { display: flex; align-items: center; gap: 12px; margin-right: auto; }
.brand__mark {
width: 26px; height: 26px; flex: none;
border-radius: 6px;
background:
linear-gradient(135deg, var(--naranja) 0 45%, transparent 45%),
linear-gradient(315deg, var(--azul) 0 45%, transparent 45%),
var(--panel-2);
border: 1px solid var(--line);
}
.brand__text { display: flex; flex-direction: column; line-height: 1.25; }
.brand__text strong { font-family: var(--serif); font-size: 1.05rem; font-weight: 600; }
.brand__text small { color: var(--azul); font-size: .78rem; }

.nav { display: flex; gap: 4px; flex-wrap: wrap; }
.nav a {
text-decoration: none;
color: var(--muted);
padding: 7px 11px;
border-radius: 999px;
font-size: .88rem;
border: 1px solid transparent;
}
.nav a:hover { color: var(--text); background: var(--panel); }
.nav a[aria-current="true"] {
color: var(--text);
background: var(--panel);
border-color: var(--line);
}

.ghost {
font: inherit; font-size: .84rem;
color: var(--muted);
background: transparent;
border: 1px solid var(--line);
border-radius: 999px;
padding: 7px 14px;
cursor: pointer;
}
.ghost:hover { color: var(--text); border-color: var(--naranja); }

/* ---------------- Hero / resumen ---------------- */

.hero {
max-width: var(--ancho);
margin: 0 auto;
padding: 56px 20px 32px;
}
.hero__kicker { color: var(--azul); font-size: .85rem; margin-bottom: 14px; }
.hero__foco {
font-size: clamp(1.9rem, 5vw, 3.1rem);
max-width: 19ch;
letter-spacing: -0.01em;
}
.hero__detalle {
margin-top: 16px;
max-width: 62ch;
color: var(--muted);
font-size: 1.02rem;
}

.ledger {
margin: 34px 0 0;
display: grid;
gap: 1px;
grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
background: var(--line-soft);
border: 1px solid var(--line-soft);
border-radius: var(--radio);
overflow: hidden;
}
.ledger__item { background: var(--panel); padding: 18px 20px; }
.ledger__item dt { color: var(--azul); font-size: .82rem; }
.ledger__item dd {
color: var(--azul-claro);
margin: 4px 0 0;
font-family: var(--serif);
font-size: 2rem;
line-height: 1;
}
.ledger__item dd span { font-size: .85rem; font-family: var(--sans); color: var(--muted); margin-left: 6px; }
.ledger__item--alerta dd { color: var(--naranja); }
.ledger__item--ok dd { color: var(--azul-claro); }

/* ---------------- Filtros ---------------- */

.filtros {
position: sticky; top: 63px; z-index: 20;
max-width: var(--ancho);
margin: 26px auto 0;
padding: 14px 20px;
display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
background: var(--ink);
background: color-mix(in srgb, var(--ink) 94%, transparent);
backdrop-filter: blur(8px);
border-top: 1px solid var(--line-soft);
border-bottom: 1px solid var(--line-soft);
}
.buscador { flex: 1 1 260px; display: block; }
.buscador input {
width: 100%;
font: inherit; font-size: .92rem;
color: var(--text);
background: var(--panel);
border: 1px solid var(--line);
border-radius: 999px;
padding: 10px 16px;
}
.buscador input::placeholder { color: var(--muted); }

.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip {
font: inherit; font-size: .82rem;
cursor: pointer;
color: var(--muted);
background: transparent;
border: 1px solid var(--line);
border-radius: 999px;
padding: 7px 13px;
}
.chip:hover { color: var(--text); }
.chip[aria-pressed="true"] {
color: var(--ink);
background: var(--naranja);
border-color: var(--naranja);
font-weight: 600;
}
html[data-theme="light"] .chip[aria-pressed="true"] { color: #fff; }

.filtros__estado { width: 100%; color: var(--muted); font-size: .8rem; }

/* ---------------- Bloques ---------------- */

.bloque {
max-width: var(--ancho);
margin: 0 auto;
padding: 52px 20px 12px;
}
.bloque__cab { margin-bottom: 24px; max-width: 70ch; }
.bloque__cab h2 { font-size: clamp(1.45rem, 3vw, 1.95rem); }
.bloque__desc { color: var(--muted); margin-top: 8px; font-size: .95rem; }

.vacio {
color: var(--muted);
border: 1px dashed var(--line);
border-radius: var(--radio);
padding: 22px;
font-size: .92rem;
}

/* Etiquetas de estado reutilizables */
.pill {
display: inline-block;
font-size: .74rem;
line-height: 1.5;
padding: 2px 10px;
border-radius: 999px;
border: 1px solid var(--line);
color: var(--muted);
white-space: nowrap;
}
.pill--alta { color: var(--rojo); border-color: var(--rojo); }
.pill--media { color: var(--naranja); border-color: var(--naranja); }
.pill--baja { color: var(--azul); border-color: var(--azul); }
.pill--info { color: var(--azul-claro); border-color: var(--azul-claro); }
.pill--nuevo { color: var(--azul); border-color: var(--azul); }

@supports (color: color-mix(in srgb, red 50%, transparent)) {
.pill--alta { border-color: color-mix(in srgb, var(--rojo) 55%, transparent); }
.pill--media { border-color: color-mix(in srgb, var(--naranja) 55%, transparent); }
.pill--baja { border-color: color-mix(in srgb, var(--azul) 55%, transparent); }
.pill--info { border-color: color-mix(in srgb, var(--azul-claro) 55%, transparent); }
.pill--nuevo { border-color: color-mix(in srgb, var(--azul) 55%, transparent); }
}

.meta { color: var(--muted); font-size: .82rem; }

/* ---------------- Comunicados (línea de tiempo) ---------------- */

.linea { list-style: none; margin: 0; padding: 0; }
.linea li {
display: grid;
grid-template-columns: 116px 1fr;
gap: 24px;
padding: 22px 0;
border-top: 1px solid var(--line-soft);
}
.linea li:last-child { border-bottom: 1px solid var(--line-soft); }
.linea__fecha { color: var(--muted); font-size: .84rem; padding-top: 3px; }
.linea__fecha b { display: block; color: var(--azul); font-size: 1.5rem; font-family: var(--serif); font-weight: 600; }
.linea__cuerpo h3 { font-size: 1.15rem; margin-bottom: 6px; }
.linea__cuerpo p { color: var(--muted); font-size: .94rem; max-width: 72ch; }
.linea__tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; align-items: center; }

/* ---------------- Temas importantes (rejilla) ---------------- */

.rejilla {
display: grid;
gap: 16px;
grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
}
.tema {
background: var(--panel);
border: 1px solid var(--line-soft);
border-radius: var(--radio);
padding: 20px;
display: flex; flex-direction: column; gap: 10px;
}
.tema h3 { font-size: 1.08rem; }
.tema__txt { color: var(--muted); font-size: .92rem; }
.tema__pie {
margin-top: auto; padding-top: 12px;
border-top: 1px solid var(--line-soft);
display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap;
}
.tema__tags { display: flex; gap: 6px; flex-wrap: wrap; }

/* ---------------- Escalaciones (tabla) ---------------- */

.tabla {
border: 1px solid var(--line-soft);
border-radius: var(--radio);
overflow: hidden;
}
.fila {
display: grid;
grid-template-columns: 6px 1fr 150px 130px;
align-items: center;
gap: 16px;
padding: 0;
background: var(--panel);
border-bottom: 1px solid var(--line-soft);
}
.fila:last-child { border-bottom: 0; }
.fila__barra { align-self: stretch; background: var(--line); }
.fila--critica .fila__barra { background: #983920; }
.fila--alta .fila__barra { background: var(--naranja); }
.fila--media .fila__barra { background: var(--azul); }
.fila--baja .fila__barra { background: var(--azul-tenue); }
.fila__main { padding: 16px 0; }
.fila__main h3 { font-size: 1.02rem; margin-bottom: 4px; }
.fila__main p { color: var(--muted); font-size: .88rem; max-width: 70ch; }
.fila__dueno { color: var(--muted); font-size: .85rem; padding: 16px 0; }
.fila__estado { padding: 16px 16px 16px 0; text-align: right; }
.fila__dias { display: block; color: var(--muted); font-size: .78rem; margin-top: 6px; }

/* ---------------- Decisiones (bitácora) ---------------- */

.bitacora { display: grid; gap: 14px; }
.decision {
background: var(--panel);
border: 1px solid var(--line-soft);
border-left: 3px solid var(--azul);
border-radius: var(--radio-s);
padding: 0;
}
.decision--pendiente { border-left-color: var(--naranja); }
.decision--revertida { border-left-color: #983920; }
.decision summary {
cursor: pointer;
list-style: none;
padding: 18px 20px;
display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap;
}
.decision summary::-webkit-details-marker { display: none; }
.decision summary h3 { font-size: 1.05rem; flex: 1 1 240px; }
.decision__id { font-family: var(--mono); font-size: .78rem; color: var(--muted); }
.decision__cuerpo { padding: 0 20px 20px; display: grid; gap: 12px; }
.decision__cuerpo dt { color: var(--azul); font-size: .8rem; }
.decision__cuerpo dd { margin: 2px 0 0; font-size: .94rem; max-width: 74ch; }

/* ---------------- Áreas (pestañas) ---------------- */

.tabs {
display: flex; gap: 6px; flex-wrap: wrap;
border-bottom: 1px solid var(--line-soft);
padding-bottom: 12px;
margin-bottom: 26px;
}
.tab {
font: inherit; font-size: .9rem;
cursor: pointer;
background: transparent;
color: var(--muted);
border: 1px solid var(--line);
border-radius: 999px;
padding: 9px 16px;
}
.tab:hover { color: var(--text); }
.tab[aria-selected="true"] {
color: var(--text);
background: var(--panel-2);
border-color: var(--azul);
}

.area { display: grid; gap: 26px; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: start; }
.area[hidden] { display: none; }
.area__intro h3 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin-bottom: 10px; }
.area__mision { color: var(--muted); max-width: 62ch; }
.area__focos { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
.area__focos li {
display: flex; gap: 12px; align-items: flex-start;
font-size: .94rem;
padding-left: 0;
}
.area__focos li::before {
content: ""; flex: none;
width: 7px; height: 7px; margin-top: 9px;
border-radius: 2px; background: var(--azul);
transform: rotate(45deg);
}
.area__lado {
background: var(--panel);
border: 1px solid var(--line-soft);
border-radius: var(--radio);
padding: 20px;
}
.area__lado h4 { margin: 0 0 14px; font-family: var(--sans); font-size: .9rem; color: var(--azul); font-weight: 600; }
.iniciativa { padding: 12px 0; border-top: 1px solid var(--line-soft); }
.iniciativa:first-of-type { border-top: 0; padding-top: 0; }
.iniciativa__cab { display: flex; justify-content: space-between; gap: 10px; font-size: .92rem; }
.iniciativa__cab span { color: var(--muted); font-variant-numeric: tabular-nums; }
.barra {
margin-top: 8px; height: 6px; border-radius: 999px;
background: var(--line-soft); overflow: hidden;
}
.barra > i { display: block; height: 100%; background: linear-gradient(90deg, var(--azul) 0%, var(--azul-claro) 100%); border-radius: 999px; }
.area__contacto { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line-soft); font-size: .86rem; color: var(--muted); }

/* ---------------- Pie ---------------- */

.pie {
margin-top: 70px;
border-top: 1px solid var(--line-soft);
background: var(--panel);
}
.pie__inner {
max-width: var(--ancho);
margin: 0 auto;
padding: 28px 20px;
display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
color: var(--muted); font-size: .88rem;
}
.pie code { font-family: var(--mono); font-size: .85em; color: var(--text); }
.pie a { color: var(--azul); }

/* ---------------- Responsive ---------------- */

@media (max-width: 900px) {
.area { grid-template-columns: 1fr; }
.fila { grid-template-columns: 6px 1fr; }
.fila__dueno { padding: 0 0 8px; }
.fila__estado { padding: 0 16px 16px 0; text-align: left; grid-column: 2; }
}

@media (max-width: 720px) {
.topbar__inner { padding: 10px 16px; gap: 10px; }
.nav { order: 3; width: 100%; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 2px; }
.nav a { white-space: nowrap; }
.filtros { position: static; }
.hero { padding-top: 38px; }
.linea li { grid-template-columns: 1fr; gap: 8px; }
.linea__fecha { display: flex; align-items: baseline; gap: 8px; }
.linea__fecha b { font-size: 1.1rem; }
.bloque { padding-top: 40px; }
}

@media (prefers-reduced-motion: reduce) {
html { scroll-behavior: auto; }
* { transition: none !important; animation: none !important; }
}

@media print {
.topbar, .filtros, .tabs, .ghost { display: none !important; }
body { background: #fff; color: #000; }
.area[hidden] { display: grid !important; }
}
